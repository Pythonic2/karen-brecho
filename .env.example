DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=gestcloud.com.br,www.gestcloud.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://gestcloud.com.br,https://www.gestcloud.com.br
SITE_BASE_URL=https://gestcloud.com.br
SQLITE_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/media
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="Telles' Thrift Shop <hello@gestcloud.com.br>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
